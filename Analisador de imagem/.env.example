# true = repete uma imagem local para testar análise + publicação Kafka
# false = recebe os frames do P4 via socket TCP
I6_TEST_MODE=true
I6_TEST_IMAGE_PATH=/app/imagemdeteste.jpg
I6_TEST_SOURCE_ID=image-analyzer-test

# Kafka (mesmo broker de referência do Detector QR)
KAFKA_BOOTSTRAP_SERVERS=34.66.235.91:9093
KAFKA_TOPIC=ods.i6.image_analysis
I6_ARTIFACT_VERSION=i6-image-analyzer-1.0

# Limite máximo de análises por segundo.
# 5.0 = no máximo cinco análises por segundo.
# 0 = analisa todos os frames recebidos.
I6_MAX_ANALYSIS_FPS=5.0

# Produção: conexão TCP com o P4 (protocolo ainda precisa ser confirmado)
P4_HOST=p4
P4_PORT=5000
P4_CONNECT_RETRY_SECONDS=2.0
