# ============================================================
# I6
# ============================================================

# true  = usa câmera(s) IP diretamente para teste
# false = recebe os frames do P4
I6_TEST_MODE=true

# ============================================================
# KAFKA
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=34.66.235.91:9093
KAFKA_TOPIC=ods.i6.code_read
I6_ARTIFACT_VERSION=i6-qrcode-reader-2.0

# ============================================================
# MODO TESTE
# ============================================================
#
# Usado apenas quando I6_TEST_MODE=true.
# Não existe cameras.json.
#
# Uma câmera:
# I6_TEST_CAMERAS_JSON=[{"source_id":"cam0","url":"http://192.168.0.50:8080/video"}]
#
# Duas câmeras:
# I6_TEST_CAMERAS_JSON=[{"source_id":"cam0","url":"http://192.168.0.50:8080/video"},{"source_id":"cam1","url":"http://192.168.0.51:8080/video"}]
#
I6_TEST_CAMERAS_JSON=[{"source_id":"cam0","url":"http://SEU_IP:PORTA/video"}]

I6_TEST_RECONNECT_SECONDS=2.0

# ============================================================
# MODO PRODUÇÃO - P4 VIA SOCKET TCP
# ============================================================
#
# Usado somente quando I6_TEST_MODE=false.
#
# O I6 atua como CLIENTE TCP.
#
# Protocolo provisório esperado:
#   4 bytes -> tamanho do JSON
#   JSON ods.p4.frame
#   8 bytes -> tamanho do frame
#   bytes do frame
#
# Quando P4 confirmar o protocolo definitivo, pode ser
# necessário ajustar apenas receber_frame_p4().
#
P4_HOST=p4
P4_PORT=5000
P4_CONNECT_RETRY_SECONDS=2.0

# ============================================================
# ESTABILIDADE DE LEITURA
# ============================================================

I6_ACQUIRE_CONFIRM_FRAMES=4
I6_SWITCH_CONFIRM_FRAMES=10
I6_SWITCH_AREA_RATIO=1.5
I6_QR_LOST_SECONDS=3.0
I6_REPEAT_COOLDOWN_SECONDS=3.0
